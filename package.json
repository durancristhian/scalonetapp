{
  "name": "scalonetapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "next build --webpack",
    "dev": "node scripts/worktree.mjs dev",
    "lint": "eslint .",
    "start": "next start",
    "vercel-build": "prisma generate && prisma migrate deploy && next build --webpack",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/worktree.mjs browser",
    "test:browser:serve": "vite --config tests/browser/vite.config.mts",
    "test:frontend": "npm run test && npm run test:browser",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "setup:worktree": "bash scripts/setup-worktree.sh",
    "check:development": "node scripts/worktree.mjs check",
    "test:setup": "node --test tests/scripts/*.test.mjs"
  },
  "dependencies": {
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@vercel/blob": "2.8.2",
    "heic-to": "1.6.7",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@clerk/nextjs": "7.9.23",
    "@hookform/resolvers": "^7.0.0",
    "@playwright/test": "^1.64.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sparticuz/chromium-min": "153.0.0",
